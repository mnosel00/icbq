<Window x:Class="ExTCCM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExTCCM"
        mc:Ignorable="d"
        Title="iCombat Stats Exporter" Height="650" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Ilość meczy do pobrania:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="RoundsToFetchTextBox" Grid.Column="0" Text="5" VerticalContentAlignment="Center" FontSize="16" Margin="0,0,10,0" Padding="5"/>
                            <Button x:Name="LoadStatsButton" Grid.Column="1" Content="Pobierz" FontSize="14" FontWeight="Bold" Padding="10,5" Click="LoadStatsButton_Click" MinWidth="80"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,10,0,0" Height="250">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Wybierz mecz z listy:" FontWeight="Bold" Margin="0,0,0,5"/>

                        <ListBox x:Name="MatchesListBox" 
                                 Grid.Row="1" 
                                 SelectionChanged="MatchesListBox_SelectionChanged"
                                 IsEnabled="False"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox x:Name="MatchSelectorCheckBox"
                                                      Grid.Column="0"
                                                      IsChecked="{Binding IsSelectedForSummary, Mode=TwoWay}"
                                                      Click="MatchSelectorCheckBox_Click"
                                                      VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" Text="{Binding MatchName}" FontWeight="Bold" FontSize="14" Margin="5,0,0,0" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding MatchResult}" 
                                                       FontWeight="Bold" 
                                                       FontSize="12" 
                                                       Foreground="#008A00" 
                                                       Margin="10,0,0,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding MatchTime, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="11" Opacity="0.8" Margin="23,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,10,0,0">
                    <Button x:Name="SumAllButton" 
                            Content="Sumuj Wszystkie Pobrane" 
                            Padding="10"
                            FontSize="14"
                            IsEnabled="False" 
                            Click="SumAllButton_Click"/>
                </Border>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Wyślij raport e-mail:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Odbiorca:" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="EmailTextBox" 
                                 Text="przyklad@email.com" 
                                 Margin="0,0,0,10"
                                 Padding="5"/>

                        <Button x:Name="GeneratePdfButton" 
                                Content="1. Generuj Raport PDF" 
                                Padding="10"
                                IsEnabled="False"
                                HorizontalAlignment="Stretch"
                                Click="GeneratePdfButton_Click"/>

                        <Button x:Name="SendEmailButton" 
                                Content="2. Wyślij Email (z PDF)" 
                                Padding="10"
                                IsEnabled="False"
                                HorizontalAlignment="Stretch"
                                Margin="0,5,0,0"
                                Click="SendEmailButton_Click"/>

                    </StackPanel>
                </Border>

            </StackPanel>

            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock x:Name="SummaryLine1TextBlock"
                               Text="Wybierz mecz z listy"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SummaryLine2TextBlock"
                               Text="" 
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="SummaryLine3TextBlock"
                               Text="" 
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TeamAName" Grid.Row="0" Text="Drużyna A" FontSize="16" FontWeight="Bold" Margin="5"/>

                        <DataGrid x:Name="TeamAGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" FontSize="14" 
                                  HeadersVisibility="Column" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#CCCCCC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gracz" Binding="{Binding Gracz}" Width="*"/>
                                <DataGridTextColumn Header="Trafienia" Binding="{Binding Zabojstwa}" Width="Auto"/>
                                <DataGridTextColumn Header="Śmierci" Binding="{Binding Smierci}" Width="Auto"/>
                                <DataGridTextColumn Header="Skuteczność" Binding="{Binding KDRatio, StringFormat='F2'}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid Grid.Column="1" Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TeamBName" Grid.Row="0" Text="Drużyna B" FontSize="16" FontWeight="Bold" Margin="5"/>

                        <DataGrid x:Name="TeamBGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" FontSize="14" 
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#CCCCCC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gracz" Binding="{Binding Gracz}" Width="*"/>
                                <DataGridTextColumn Header="Trafienia" Binding="{Binding Zabojstwa}" Width="Auto"/>
                                <DataGridTextColumn Header="Śmierci" Binding="{Binding Smierci}" Width="Auto"/>
                                <DataGridTextColumn Header="Skuteczność" Binding="{Binding KDRatio, StringFormat='F2'}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="1"
                   Text="Wprowadź liczbę meczy i kliknij 'Pobierz'..."
                   Margin="5,10,5,0"
                   FontSize="12"
                   Opacity="0.7"/>
    </Grid>
</Window>