@inherits LayoutComponentBase

<MudThemeProvider Theme="_customTheme" IsDarkMode="true" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Style="background-color: #0b0b0f; min-height: 100vh; overflow: hidden;">
    <MudAppBar Elevation="0" Style="background-color: #12121a; border-bottom: 1px solid rgba(255,255,255,0.05);">
        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Primary" Class="mr-2" />
        <MudText Typo="Typo.h6" Style="font-weight: 800; letter-spacing: 1.5px; color: #fff;">
            ExTCCM <span style="color: var(--mud-palette-primary); font-weight: 400; font-size: 0.9rem;">STATS CONSOLE</span>
        </MudText>
        <MudSpacer />
    </MudAppBar>
    <MudMainContent Class="pa-0">
        <div class="pa-4">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _customTheme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#10b981",      // Esportowy Szmaragd/Zieleń (Neonowy akcent)
            Secondary = "#6366f1",    // Indigo do akcji pobocznych (PDF)
            Background = "#0b0b0f",   // Głęboka, czysta czerń gamingowa
            Surface = "#12121a",      // Kolor kart i paneli
            AppbarBackground = "#12121a",
            TextPrimary = "#f3f4f6",   // Bardzo czytelny biały/szary tekst
            TextSecondary = "#9ca3af", // Pomocnicze podpisy
            Dark = "#27272a"          // Tło wierszy np. dla zespołu Black
        }
    };
}