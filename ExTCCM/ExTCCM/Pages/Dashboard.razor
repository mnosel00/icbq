@page "/"
@using ExTCCM.Models
@using ExTCCM.Services
@using ExTCCM.Documents
@using QuestPDF.Fluent
@using System.Diagnostics
@using Microsoft.Win32
@inject StatsService StatsService
@inject ISnackbar Snackbar

<style>
    /* Custom gaming adjustments to enforce zero scrolling on tables and high density */
    .gaming-table .mud-table-container {
        overflow-y: hidden !important; /* Block vertical scroll completely */
    }

    .gaming-table tr th, .gaming-table tr td {
        padding: 4px 8px !important; /* Ultra-dense padding for maximum data density */
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
    }

    .team-card {
        border-top: 4px solid var(--team-border-color, #777) !important;
        background-color: #1a1a24 !important;
    }
</style>

<MudGrid Spacing="3" Class="pa-2" Style="height: calc(100vh - 80px); overflow: hidden;">

    <!-- LEFT PANEL: Configuration, Matches & Actions (25% width) -->
    <MudItem xs="12" md="3" Class="d-flex flex-column" Style="height: 100%; gap: 12px;">

        <!-- Quick Config & Loader Card -->
        <MudCard Elevation="4" Style="background-color: #1a1a24;">
            <MudCardContent Class="pa-3">
                <MudText Typo="Typo.overline" Color="Color.Inherit" Class="opacity-60 d-block mb-1">Panel Sterowania</MudText>
                <div class="d-flex align-center gap-2">
                    <MudNumericField @bind-Value="RoundsToFetch" Label="Rundy" Variant="Variant.Outlined" Min="1" Max="50" Margin="Margin.Dense" Class="flex-grow-0" Style="width: 80px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="LoadStats" Disabled="@_isBusy" Size="Size.Medium" Style="height: 40px; font-weight: bold;">
                        @if (_isBusy)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <span>ZAŁADUJ</span>
                        }
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="mt-1 d-block text-right" Color="Color.Secondary">@_statusMessage</MudText>
            </MudCardContent>
        </MudCard>

        <!-- Match Selector Card (Takes maximum remaining space) -->
        <MudCard Elevation="4" Class="flex-grow-1 d-flex flex-column" Style="background-color: #1a1a24; overflow: hidden;">
            <MudCardHeader Class="pa-3 border-b-1 border-solid border-dark">
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">WYBIERZ MECZE</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">Wybrano: @_selectedMatches.Count</MudChip>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-0 flex-grow-1" Style="overflow-y: auto;">
                <MudTable T="MatchInfo" Items="_matches" MultiSelection="true" Dense="true" Hover="true"
                          SelectedItems="_selectedMatches"
                          SelectedItemsChanged="OnSelectionChanged"
                          Elevation="0" BackgroundColor="Color.Transparent">
                    <RowTemplate>
                        <MudTd DataLabel="Mecz" Class="py-1">
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.MatchName</MudText>
                            <MudText Typo="Typo.caption" Class="opacity-50">@context.MatchTime.ToShortTimeString()</MudText>
                        </MudTd>
                        <MudTd DataLabel="Wynik" Class="py-1 text-right">
                            @if (context.MatchResult.Contains("Black", StringComparison.OrdinalIgnoreCase))
                            {
                                <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Filled" Style="border: 1px solid #444; font-size: 0.75rem;">Black Win</MudChip>
                            }
                            else if (context.MatchResult.Contains("Green", StringComparison.OrdinalIgnoreCase))
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Style="font-size: 0.75rem;">Green Win</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Style="font-size: 0.75rem;">Remis</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>

        <!-- Export Actions Card -->
        <MudCard Elevation="4" Style="background-color: #1a1a24;">
            <MudCardContent Class="pa-3 d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="GeneratePdf" FullWidth="true" Size="Size.Small">PDF</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Email" OnClick="SendEmail" FullWidth="true" Size="Size.Small">EMAIL</MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- RIGHT PANEL: Dashboard Stats (75% width) - Core View -->
    <MudItem xs="12" md="9" Class="d-flex flex-column" Style="height: 100%;">
        <MudCard Elevation="4" Class="flex-grow-1 d-flex flex-column pa-2" Style="background-color: #12121a;">
            <MudGrid Class="flex-grow-1" Style="height: 100%;">

                <!-- TEAM A COLUMN -->
                <MudItem xs="12" sm="6" Class="d-flex flex-column" Style="height: 100%;">
                    <MudCard Elevation="2" Class="team-card flex-grow-1 d-flex flex-column" Style="--team-border-color: #2b2b2b;">
                        <div class="pa-3 d-flex justify-space-between align-center" style="background: rgba(0,0,0,0.2);">
                            <div>
                                <MudText Typo="Typo.button" Class="font-weight-bold" Style="color: #bbb; letter-spacing: 1px;">DRUŻYNA @_teamAName.ToUpper()</MudText>
                                <MudText Typo="Typo.caption" Class="d-block opacity-50">Suma fragów: @_teamAStats.Sum(x => x.Zabojstwa)</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Shield" Style="color: #bbb;" Size="Size.Medium" />
                        </div>

                        <div class="flex-grow-1" Style="overflow: hidden;">
                            <MudTable T="PlayerStats" Items="_teamAStats" Dense="true" Hover="true" Elevation="0"
                                      Class="gaming-table" BackgroundColor="Color.Transparent"
                                      Style="@($"font-size: {( _teamAStats.Count > 8 ? "0.8rem" : "0.9rem" )};")">
                                <HeaderContent>
                                    <MudTh>GRACZ</MudTh>
                                    <MudTh Style="text-align: center;">KILLS</MudTh>
                                    <MudTh Style="text-align: center;">DEATHS</MudTh>
                                    <MudTh Style="text-align: right;">K/D RATIO</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Class="font-weight-bold" Style="color: #eceff1;">@context.Gracz</MudTd>
                                    <MudTd Style="text-align: center; font-weight: bold; color: #4caf50;">@context.Zabojstwa</MudTd>
                                    <MudTd Style="text-align: center; color: #ef5350;">@context.Smierci</MudTd>
                                    <MudTd Style="text-align: right;">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetKDRatioColor(context.KDRatio)"
                                                 Variant="Variant.Filled"
                                                 Style="font-weight: bold; min-width: 55px; text-align: center; font-size: 0.8rem;">
                                            @context.KDRatio.ToString("0.00")
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    </MudCard>
                </MudItem>

                <!-- TEAM B COLUMN -->
                <MudItem xs="12" sm="6" Class="d-flex flex-column" Style="height: 100%;">
                    <MudCard Elevation="2" Class="team-card flex-grow-1 d-flex flex-column" Style="--team-border-color: #2e7d32;">
                        <div class="pa-3 d-flex justify-space-between align-center" style="background: rgba(0,0,0,0.2);">
                            <div>
                                <MudText Typo="Typo.button" Class="font-weight-bold" Style="color: #4caf50; letter-spacing: 1px;">DRUŻYNA @_teamBName.ToUpper()</MudText>
                                <MudText Typo="Typo.caption" Class="d-block opacity-50">Suma fragów: @_teamBStats.Sum(x => x.Zabojstwa)</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Shield" Style="color: #4caf50;" Size="Size.Medium" />
                        </div>

                        <div class="flex-grow-1" Style="overflow: hidden;">
                            <MudTable T="PlayerStats" Items="_teamBStats" Dense="true" Hover="true" Elevation="0"
                                      Class="gaming-table" BackgroundColor="Color.Transparent"
                                      Style="@($"font-size: {( _teamBStats.Count > 8 ? "0.8rem" : "0.9rem" )};")">
                                <HeaderContent>
                                    <MudTh>GRACZ</MudTh>
                                    <MudTh Style="text-align: center;">KILLS</MudTh>
                                    <MudTh Style="text-align: center;">DEATHS</MudTh>
                                    <MudTh Style="text-align: right;">K/D RATIO</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Class="font-weight-bold" Style="color: #eceff1;">@context.Gracz</MudTd>
                                    <MudTd Style="text-align: center; font-weight: bold; color: #4caf50;">@context.Zabojstwa</MudTd>
                                    <MudTd Style="text-align: center; color: #ef5350;">@context.Smierci</MudTd>
                                    <MudTd Style="text-align: right;">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetKDRatioColor(context.KDRatio)"
                                                 Variant="Variant.Filled"
                                                 Style="font-weight: bold; min-width: 55px; text-align: center; font-size: 0.8rem;">
                                            @context.KDRatio.ToString("0.00")
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    </MudCard>
                </MudItem>

            </MudGrid>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private int RoundsToFetch { get; set; } = 5;
    private bool _isBusy = false;
    private string _statusMessage = "System gotowy";

    private List<MatchInfo> _matches = new();
    private HashSet<MatchInfo> _selectedMatches = new();
    private List<PlayerStats> _allPlayerStats = new();

    private List<PlayerStats> _teamAStats = new();
    private List<PlayerStats> _teamBStats = new();

    private string _teamAName = "Black";
    private string _teamBName = "Green";

    protected override void OnInitialized()
    {
        QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;

        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
        Snackbar.Configuration.PreventDuplicates = true;
        Snackbar.Configuration.ShowCloseIcon = true;
        Snackbar.Configuration.VisibleStateDuration = 4000;
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
    }

    private async Task LoadStats()
    {
        _isBusy = true;
        _statusMessage = "Pobieranie...";
        _matches.Clear();
        _selectedMatches.Clear();
        _allPlayerStats.Clear();
        _teamAStats.Clear();
        _teamBStats.Clear();

        StateHasChanged();

        try
        {
            int count = Math.Max(1, RoundsToFetch);
            var rawKills = await StatsService.LoadStatsAsync(count);
            var result = StatsService.ProcessRawData(rawKills);

            _matches = result.Matches;
            _allPlayerStats = result.PlayerStats;

            if (_matches.Any())
            {
                _selectedMatches.Add(_matches.First());
            }

            RecalculateSummaries();
            _statusMessage = $"Załadowano: {_matches.Count}";
            Snackbar.Add($"Załadowano {_matches.Count} meczów", Severity.Success);
        }
        catch (Exception ex)
        {
            _statusMessage = "Błąd bazy.";
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnSelectionChanged(HashSet<MatchInfo> selectedItems)
    {
        _selectedMatches = selectedItems;
        RecalculateSummaries();
    }

    private void RecalculateSummaries()
    {
        _teamAStats.Clear();
        _teamBStats.Clear();

        if (!_selectedMatches.Any())
        {
            StateHasChanged();
            return;
        }

        var selectedMatchIds = _selectedMatches.Select(m => m.MatchId).ToHashSet();
        var relevantStats = _allPlayerStats.Where(s => selectedMatchIds.Contains(s.MatchId)).ToList();

        var grouped = relevantStats
            .GroupBy(s => new { s.Gracz, s.Drużyna })
            .Select(g => new PlayerStats
            {
                Gracz = g.Key.Gracz,
                Drużyna = g.Key.Drużyna,
                Zabojstwa = g.Sum(x => x.Zabojstwa),
                Smierci = g.Sum(x => x.Smierci)
            })
            .ToList();

        var teamNames = grouped.Select(p => p.Drużyna).Distinct().Take(2).ToList();

        if (teamNames.Count > 0)
        {
            _teamAName = teamNames[0];
            _teamAStats = grouped.Where(p => p.Drużyna == teamNames[0]).OrderByDescending(p => p.Zabojstwa).ToList();
        }

        if (teamNames.Count > 1)
        {
            _teamBName = teamNames[1];
            _teamBStats = grouped.Where(p => p.Drużyna == teamNames[1]).OrderByDescending(p => p.Zabojstwa).ToList();
        }

        StateHasChanged();
    }

    // Dynamic, professional color thresholds for K/D Ratio
    private Color GetKDRatioColor(double kd)
    {
        return kd switch
        {
            >= 1.50 => Color.Success, // Carry status (Green)
            >= 1.00 => Color.Info,    // Solid performance (Blue/Cyan)
            >= 0.75 => Color.Warning, // Needs improvement (Orange)
            _ => Color.Error          // Hard match (Red)
        };
    }

    private void GeneratePdf()
    {
        if (!_selectedMatches.Any())
        {
            Snackbar.Add("Wybierz mecz do eksportu.", Severity.Warning);
            return;
        }

        try
        {
            var saveFileDialog = new SaveFileDialog
            {
                Filter = "PDF file (*.pdf)|*.pdf",
                FileName = $"Raport_{DateTime.Now:yyyyMMdd_HHmm}.pdf"
            };

            if (saveFileDialog.ShowDialog() == true)
            {
                var summaryStats = new List<PlayerStats>();
                summaryStats.AddRange(_teamAStats);
                summaryStats.AddRange(_teamBStats);

                var document = new PdfReportDocument(_selectedMatches.ToList(), _allPlayerStats, summaryStats);
                document.GeneratePdf(saveFileDialog.FileName);

                Snackbar.Add($"Zapisano PDF", Severity.Success);
                _lastGeneratedPdfPath = saveFileDialog.FileName;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd PDF: {ex.Message}", Severity.Error);
        }
    }

    private string _lastGeneratedPdfPath = string.Empty;

    private void SendEmail()
    {
        try
        {
            string mailto = "mailto:?subject=Statystyki Laser Tag&body=W zalaczeniu przesylam wygenerowany raport statystyk.";
            Process.Start(new ProcessStartInfo(mailto) { UseShellExecute = true });

            if (!string.IsNullOrEmpty(_lastGeneratedPdfPath))
            {
                Snackbar.Add("Załącz plik z: " + _lastGeneratedPdfPath, Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd poczty: {ex.Message}", Severity.Error);
        }
    }
}